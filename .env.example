# Copy this file to `.env` and fill it in. `.env` is gitignored — never commit
# real keys.

# Where the app is reachable. Magic links are built from this, so it must
# match what the browser actually uses.
BASE_URL=http://localhost:8080
PORT=8080

# Resend API key (https://resend.com/api-keys). Leave blank and sign-in links
# are printed to the server console instead of emailed — useful before DNS is
# set up.
RESEND_API_KEY=

# The From address. Until your domain is verified with Resend you can only
# use their sandbox sender, and it will only deliver to your own account
# address. Once verified, switch to your domain.
MAIL_FROM=TravelFix <onboarding@resend.dev>
# MAIL_FROM=TravelFix <hello@yourdomain.com>

# Optional tuning
# LOGIN_TOKEN_TTL_SECONDS=900
# SESSION_TTL_SECONDS=2592000
# RATE_LIMIT_PER_IP=10
# RATE_LIMIT_PER_EMAIL=5
# ENV=development
